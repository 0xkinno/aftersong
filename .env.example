# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Qloo hackathon key (Google form in the developer guide). Used by the backend only.
QLOO_API_KEY=
QLOO_HOST=https://hackathon.api.qloo.com

# Model key: fill in ONE provider. MODEL_PROVIDER is anthropic, openrouter or nvidia.
MODEL_PROVIDER=
MODEL_ID=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Supabase (Phase 3). The service role key goes on the backend only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Wiring between the web app and the backend
BACKEND_URL=http://localhost:8787
BACKEND_SHARED_SECRET=
PORT=8787

# Public lock and daily caps (Phase 6)
PUBLIC_LOCK=on
DAILY_QLOO_CAP=300
